{
    "name": "@jbuncle/webmon-web",
    "version": "1.0.0",
    "description": "Webmon Web Interface",
    "scripts": {
        "server:start": "ts-node --project tsconfig.server.json src/server.ts ",
        "build:server": "tsc --project tsconfig.server.json && ncc build -m src/server.js && rm -rf dist/web ",
        "watch:web": "webpack --watch --mode development",
        "build:web": "webpack --mode production",
        "build": "rm -rf dist && npm run build:server && npm run build:web && cp -r src/web/*.html dist/web"
    },
    "dependencies": {
        "@types/jquery": "^3.5.32",
        "chart.js": "^2.9.4",
        "core-js": "^3.46.0",
        "express": "^4.21.2",
        "morgan": "^1.10.1"
    },
    "devDependencies": {
        "@types/chart.js": "^2.9.41",
        "@types/express": "^5.0.3",
        "@types/morgan": "^1.9.10",
        "@types/node": "^18.19.124",
        "@vercel/ncc": "^0.38.4",
        "ts-loader": "^9.5.4",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.2",
        "webpack": "^5.105.4",
        "webpack-cli": "^5.1.4"
    }
}
